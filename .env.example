# ------------------------------------------------------------------
# Скопируй файл в .env и заполни значения.
# .env читается автоматически при старте server.js
# ------------------------------------------------------------------

# Токен бота от @BotFather. Без него сервер запустится в ДЕМО-режиме.
BOT_TOKEN=

# Ключ для входа в админку /admin. Придумай длинную случайную строку.
ADMIN_TOKEN=

# Публичный HTTPS-адрес мини-аппа (без слэша на конце).
# Нужен для кнопки «Позвать своих», например: https://halloween.example.com
PUBLIC_URL=

# Username бота без @ (например, HaHalloweenbot). Используется в «Позвать своих»:
# гостям отправляется ссылка https://t.me/<username>, а не адрес туннеля.
BOT_USERNAME=

# Порт сервера
PORT=3000

# Срок жизни initData (секунды). 86400 = сутки. 0 — не проверять.
MAX_INIT_AGE=86400

# 1 — доверять заголовку X-Forwarded-For (когда сервер стоит за nginx/Caddy
# или за туннелем cloudflared). Нужно, чтобы лимит запросов и dev-режим
# считались по реальному IP гостя.
# TRUST_PROXY=1

# Название вечеринки (необязательно, пока нигде не выводится)
# PARTY_TITLE=Хэллоуин у Макса

# 1 — разрешить вход без Telegram. Если BOT_TOKEN задан, такой вход работает
# только с этого же компьютера (localhost) — удобно проверять интерфейс.
# 0 — мини-апп работает исключительно внутри Telegram (рекомендуется).
# Включается автоматически, если BOT_TOKEN пустой.
# DEV_MODE=0

# Каталог для хранения данных (по умолчанию ./data)
# DATA_DIR=./data

# Куда складывать CSV/MD из `npm run export` (по умолчанию ./exports)
# EXPORT_DIR=./exports
